---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Jakub Piskorz – Work in progress">
	<main class="flex min-h-[70vh] items-center justify-center p-8">
		<div class="mx-auto w-full max-w-md rounded-2xl border border-border bg-background p-8 shadow-sm">
			<div class="space-y-6 text-center">
				<div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-border">
					<span class="text-sm font-mono text-muted-foreground">WIP</span>
				</div>

				<div class="space-y-2">
					<h1 class="text-xl font-semibold tracking-tight">
						Site under construction
					</h1>
					<p class="text-sm text-muted-foreground">
						I’m currently rebuilding my blog & portfolio.
						This page will soon showcase selected frontend work,
						experiments, and writing.
					</p>
				</div>

				<div class="pt-4">
					<p class="text-xs text-muted-foreground">
						Frontend Developer · React · Astro · TypeScript
					</p>
				</div>
			</div>
		</div>
	</main>
</Layout>

<style>
	@page {
		size: auto;
		margin: 0mm;
	}
	main {
		margin: auto;
		width: 100%;
	}
</style>
